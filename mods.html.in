<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Explore Cinnabar community mods and inspect their requested permissions.">
  <title>Marketplace · Cinnabar</title>
  <link rel="icon" type="image/svg+xml" href="@@FAVICON@@">
  <meta name="theme-color" content="#141312">
  <link rel="preload" href="/assets/fonts/schibsted-grotesk-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/marketplace.css">
  <style>@@SITE_HEADER_STYLES@@</style>
</head>
<body>
  <a class="skip-link" href="#app">Skip to marketplace</a>
  @@SITE_HEADER@@
  <div class="shell">
    <div class="market-heading">
      <div><h1>Mods</h1><p>Mods for Cinnabar.</p></div>
      <div class="account" id="account"></div>
    </div>
    <div class="preview-note" id="preview-note" hidden><p><strong>Design preview</strong> · Sample mods and accounts. Nothing is installed.</p><button type="button" id="reset-preview" class="quiet">Reset</button></div>
    <nav class="tabs" id="navigation" aria-label="Marketplace"></nav>
    <main id="app" tabindex="-1"><p class="empty" role="status">Loading marketplace…</p></main>
    <noscript><p class="notice">Enable JavaScript to browse the marketplace. Client downloads remain available on the home page.</p></noscript>
    <p id="feedback" class="feedback" role="status" aria-live="polite" aria-atomic="true"></p>
    <footer class="market-footer"><span>Cinnabar community mods</span><a href="/docs/modding/">Create a mod</a></footer>
  </div>
  <dialog id="signin-dialog" aria-labelledby="signin-title">
    <div class="row between"><h2 id="signin-title">Choose a preview account</h2><button type="button" data-close class="quiet" aria-label="Close account chooser">Close</button></div>
    <p class="muted">Sample accounts demonstrate player, creator and staff workflows. Real Google sign-in is provided by the API in live mode.</p>
    <div id="signin-body" class="personas"></div>
  </dialog>
  <dialog id="username-dialog" aria-labelledby="username-title" aria-describedby="username-note">
    <div class="row between"><h2 id="username-title">Choose your username</h2><button type="button" id="username-close" class="quiet" aria-label="Close username chooser">Close</button></div>
    <p id="username-note">Your username is public and can’t be changed later.</p>
    <form id="username-form" class="gap" novalidate>
      <label class="field" for="username-input">Username
        <input id="username-input" name="username" type="text" autocomplete="username" autocapitalize="none" spellcheck="false" required minlength="3" maxlength="16" pattern="[A-Za-z0-9_]{3,16}" aria-describedby="username-hint username-status">
      </label>
      <small id="username-hint" class="muted">3–16 letters, digits or underscores.</small>
      <p id="username-status" class="small error" role="alert" aria-live="polite" aria-atomic="true"></p>
      <div class="row gap"><button type="submit" id="username-confirm" class="btn primary">Confirm username</button></div>
    </form>
  </dialog>
  <dialog id="xbox-dialog" aria-labelledby="xbox-title">
    <div class="row between"><h2 id="xbox-title">Link Xbox</h2><button type="button" id="xbox-close" class="quiet" aria-label="Close Xbox linking">Close</button></div>
    <div id="xbox-body"></div>
    <p id="xbox-status" class="small" role="status" aria-live="polite"></p>
  </dialog>
  <script src="/downloads.js" defer></script>
  <script src="/marketplace-capabilities.js" defer></script>
  <script src="/marketplace-core.js" defer></script>
  <script src="/marketplace-content.js" defer></script>
  <script src="/marketplace-mock.js" defer></script>
  <script src="/marketplace-http.js" defer></script>
  <script src="/marketplace-validation.js" defer></script>
  <script src="/marketplace.js" defer></script>
</body>
</html>
